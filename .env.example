# Copy to .env and fill in. Every variable src/env.ts reads is listed here
# (test/env-example.test.ts keeps the two in step). Never commit the real .env.

# --- MongoDB (required) ---
MONGO_URI=mongodb://localhost:27017
# Optional if the database name is part of MONGO_URI.
MONGO_DB_NAME=recharge-partners

# --- Scheduler (in-process node-cron) ---
# "true" or "1" turns the schedule on; anything else leaves pulls manual.
CRON_ENABLED=false
CRON_EXPRESSION=0 */6 * * *
CRON_TIMEZONE=Europe/Ljubljana
# Protects POST /api/cron/run. Leave empty to disable that endpoint's secret check.
CRON_SECRET=

# --- Partner feeds ---
# POINT-7 export link, including its token. Required to pull POINT-7.
POINT7_FEED_URL=
# Optional override of the public Equipe Trading stock link (Unifiber).
UNIFIBER_STOCK_URL=

# --- Runtime ---
# development | production | test (defaults to development)
NODE_ENV=development
